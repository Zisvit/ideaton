# ==== Карьерный трекер — пример окружения ====
# Копирование:  cp .env.example .env      (сам .env в .gitignore, не коммитить)
# Запуск стенда из корня репозитория:
#   docker-compose --env-file .env -f infra/docker-compose.yml up --build

# --- API (services/api) ---
PORT=8000
# Адрес API для фронтенда. В докере — имя сервиса: http://api:8000
API_URL=http://localhost:8000

# --- LLM (только backend!) ---
# false => rule-based скоринг, внешние вызовы не делаются, ключ не нужен
# true без LLM_URL => консультант молча работает в демо-режиме (stub) + warn в лог
LLM_ENABLED=false
LLM_MODEL=gpt-4o-mini
# OpenAI-совместимый /chat/completions или произвольный POST-эндпоинт
LLM_URL=
# НИКОГДА не отдавать во фронтенд (apps/web): ключ видит только services/api
LLM_API_KEY=
